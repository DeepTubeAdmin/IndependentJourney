# Copy this file to .env.local for local development and fill in the values.
# .env.local is ignored by git, so your keys never get committed.
#
# Variables starting with EXPO_PUBLIC_ are built into the app and are visible
# to anyone. Only put public values there. Secret keys go in Supabase
# (Edge Functions -> Secrets) or Netlify, never here with EXPO_PUBLIC_.

# Supabase: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# "development", "preview", or "production"
EXPO_PUBLIC_APP_ENV=development
