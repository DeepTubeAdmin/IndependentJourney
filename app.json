{
  "expo": {
    "name": "Independent Journey",
    "slug": "independent-journey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.independentjourney.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:independentjourney.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F5EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.independentjourney.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "independentjourney.com",
              "pathPrefix": "/confirm"
            },
            {
              "scheme": "https",
              "host": "independentjourney.com",
              "pathPrefix": "/welcome"
            },
            {
              "scheme": "https",
              "host": "independentjourney.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "independentjourney.com",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "independentjourney.com",
              "pathPrefix": "/s"
            },
            {
              "scheme": "https",
              "host": "independentjourney.com",
              "pathPrefix": "/share"
            },
            {
              "scheme": "https",
              "host": "independentjourney.com",
              "pathPrefix": "/messages"
            },
            {
              "scheme": "https",
              "host": "independentjourney.com",
              "pathPrefix": "/browse"
            },
            {
              "scheme": "https",
              "host": "independentjourney.com",
              "pathPrefix": "/membership"
            },
            {
              "scheme": "https",
              "host": "independentjourney.com",
              "pathPrefix": "/settings"
            },
            {
              "scheme": "https",
              "host": "independentjourney.com",
              "pathPrefix": "/home"
            },
            {
              "scheme": "https",
              "host": "independentjourney.com",
              "pathPrefix": "/saved"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Independent Journey uses your photo library so you can choose photos for your profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#8C6E57",
          "defaultChannel": "messages"
        }
      ]
    ],
    "scheme": "independentjourney",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0bccfd22-f585-4625-8d54-974d78c3993e"
      }
    }
  }
}
